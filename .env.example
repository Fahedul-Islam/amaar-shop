# ========================
# Amaar Shop — Environment
# ========================

# PostgreSQL
POSTGRES_DB=amaarshop
POSTGRES_USER=amaarshop
POSTGRES_PASSWORD=change_me_in_production

# Backend
PORT=8080
DATABASE_URL=postgres://amaarshop:change_me_in_production@postgres:5432/amaarshop?sslmode=disable
JWT_SECRET=change_me_to_a_random_64_char_string
UPLOAD_DIR=/app/uploads

# Admin seed (created on first startup if no admin exists)
ADMIN_EMAIL=admin@amaarshop.com
ADMIN_PASSWORD=change_me_admin_password

# Frontend
VITE_API_URL=http://localhost:8080
