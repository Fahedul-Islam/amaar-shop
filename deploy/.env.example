# Amaar Shop — production environment for the Oracle Cloud VM.
#
# Copy this to `.env` ON THE SERVER and fill in every value:
#     cp .env.example .env && nano .env
#
# This example file is committed to git. `.env` is git-ignored — never commit
# the real one, and never paste these values into a chat, issue, or screenshot.

# ---------------------------------------------------------------- database ---
POSTGRES_DB=amaarshop
POSTGRES_USER=amaarshop
# Letters and numbers ONLY — this value is embedded in a connection URL, and
# characters like @ : / # ? would break it. Generate one with:
#     openssl rand -hex 24
POSTGRES_PASSWORD=

# --------------------------------------------------------------------- API ---
# Signs login tokens. Changing it later logs everyone out. Generate with:
#     openssl rand -base64 48
JWT_SECRET=

# The first admin account. Created automatically on first startup if no admin
# exists yet. Use a real address you control and a long password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# The public HTTPS hostname of THIS server — no https://, no trailing slash.
# Example: amaarshop-api.duckdns.org
API_DOMAIN=

# Your live frontend origin(s), comma-separated, with https:// and no trailing
# slash. Example: https://amaarshop.vercel.app,https://amaarshop.com
CORS_ALLOWED_ORIGINS=
